rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function googleSignedIn() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function sessionExists(code) {
      return exists(/databases/$(database)/documents/sessions/$(code));
    }
    function isHost(code) {
      return googleSignedIn() && sessionExists(code)
        && get(/databases/$(database)/documents/sessions/$(code)).data.hostUid == request.auth.uid;
    }
    function canClaimHostTransfer() {
      return googleSignedIn()
        && resource.data.hostTransferPending == true
        && resource.data.hostTransferExpiresAt is timestamp
        && request.time < resource.data.hostTransferExpiresAt
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostTransferPending == false
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['hostUid', 'hostTransferPending']);
    }

    match /sessions/{code} {
      allow read: if signedIn();
      allow create: if googleSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status in ['running', 'paused', 'ended'];
      allow update: if (isHost(code)
          && request.resource.data.hostUid == resource.data.hostUid)
        || canClaimHostTransfer();
      allow delete: if isHost(code);

      match /students/{uid} {
        allow read: if isHost(code) || (signedIn() && request.auth.uid == uid);
        allow create, update: if signedIn() && request.auth.uid == uid
          && sessionExists(code)
          && get(/databases/$(database)/documents/sessions/$(code)).data.status == 'running'
          && get(/databases/$(database)/documents/sessions/$(code)).data.hostUid != uid
          && request.resource.data.keys().hasOnly([
            'uid', 'name', 'status', 'runId', 'activeDurationMs', 'awayDurationMs', 'lastSeen',
            'checkInCycleId', 'checkInRound', 'checkInPromptId', 'checkInAt', 'timeline'
          ])
          && request.resource.data.uid == uid
          && (!('runId' in request.resource.data)
            || request.resource.data.runId == get(/databases/$(database)/documents/sessions/$(code)).data.runId)
          && (!('activeDurationMs' in request.resource.data)
            || (request.resource.data.activeDurationMs is number && request.resource.data.activeDurationMs >= 0))
          && (!('awayDurationMs' in request.resource.data)
            || (request.resource.data.awayDurationMs is number && request.resource.data.awayDurationMs >= 0))
          && (!('timeline' in request.resource.data)
            || (request.resource.data.timeline is list && request.resource.data.timeline.size() <= 400))
          && (!('checkInCycleId' in request.resource.data)
            || request.resource.data.checkInCycleId is string)
          && (!('checkInRound' in request.resource.data)
            || (request.resource.data.checkInRound is number && request.resource.data.checkInRound >= 1))
          && (!('checkInPromptId' in request.resource.data)
            || request.resource.data.checkInPromptId is string)
          && (!('checkInAt' in request.resource.data)
            || request.resource.data.checkInAt is timestamp)
          && request.resource.data.status in ['active', 'away', 'left'];
        allow delete: if isHost(code) || (signedIn() && request.auth.uid == uid);
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
