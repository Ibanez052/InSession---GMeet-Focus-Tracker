{
  "manifest_version": 3,
  "name": "InSession – GMeet Focus Tracker",
  "version": "1.0",
  "description": "Shows Google Meet participant focus status during a session.",
  "permissions": ["identity", "activeTab", "storage"],
  "oauth2": {
    "client_id": "433861086598-lssi7ehea8ij8339c7d4197ksmhv5j92.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "action": {
    "default_popup": "dist/src/popup/popup.html",
    "default_icon": "assets/logo.png"
  },
  "host_permissions": [
    "https://meet.google.com/*",
    "https://firestore.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["dist/src/content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
