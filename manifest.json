{
  "manifest_version": 3,
  "name": "InSession – GMeet Focus Tracker",
  "version": "1.0",
  "description": "Shows participant focus status and instructor-configurable activity check-ins during Google Meet sessions.",
  "key": "",
  "permissions": ["identity", "activeTab", "storage", "sidePanel", "downloads"],
  "background": {
    "service_worker": "dist/src/background/service-worker.js"
  },
  "oauth2": {
    "client_id": "433861086598-277ccjc52p5jf0g8iru6hmdom65bfk1v.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "action": {
    "default_title": "Open InSession attendance dashboard",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "side_panel": {
    "default_path": "dist/src/popup/popup.html"
  },
  "host_permissions": [
    "https://meet.google.com/*",
    "https://firestore.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["dist/src/content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
